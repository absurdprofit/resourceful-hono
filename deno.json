{
  "workspace": ["packages/*", "example"],
  "tasks": {
    "list": "deno run --allow-all tasks/list.ts",
    "test": "deno test --coverage --parallel"
  },
  "publish": {
    "exclude": [
      "./example"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "deno.window",
      "esnext",
      "dom",
      "dom.iterable"
    ]
  }
}