{
  "workspace": ["packages/*", "example"],
  "tasks": {
    "prepare": "deno run -A npm:husky",
    "list": "deno run --allow-all tasks/list.ts",
    "test": "deno test --trace-leaks --coverage --parallel --allow-net",
    "lint": "deno run -A npm:eslint --config eslint.config.ts . --fix",
    "lint-staged": "deno run -A npm:lint-staged"
  },
  "nodeModulesDir": "auto",
  "publish": {
    "exclude": [
      "./example"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "deno.window",
      "esnext",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "@eslint/js": "npm:@eslint/js@^9.23.0",
    "@stylistic/eslint-plugin-js": "npm:@stylistic/eslint-plugin-js@^4.2.0",
    "@typescript-eslint/eslint-plugin": "npm:@typescript-eslint/eslint-plugin@^8.27.0",
    "globals": "npm:globals@^16.0.0",
    "husky": "npm:husky@^9.1.7",
    "jiti": "npm:jiti@^2.4.2",
    "lint-staged": "npm:lint-staged@^15.5.0",
    "typescript-eslint": "npm:typescript-eslint@^8.27.0"
  }
}